# BotFather 创建机器人后取得 token；不要提交真实凭据。
TELEGRAM_BOT_TOKEN=
# 私聊的数字 ID、群组的负数 ID，或频道 @username
TELEGRAM_CHAT_ID=
# 可选：论坛群组话题 ID；普通会话留空
TELEGRAM_MESSAGE_THREAD_ID=
# 榜单使用原生富消息（Bot API 10.3+）；Telegram 客户端需支持富消息和标题复制按钮。

# 按北京时间固定时点扫描，默认每 15 分钟；也可改为 10。
MONITOR_INTERVAL_MINUTES=15
MONITOR_TOP_COUNT=20
# 霸榜按连续在榜时长计算，扫描间隔改变不影响门槛。
MONITOR_DOMINANCE_MINUTES=60

# 服务启动/重启时发送一条独立状态消息；仍遵守静默时段，false 可关闭。
NOTIFY_ON_STARTUP=true

# 首次启动及每天 07:00 建立基础榜单；重启恢复当天消息。
# 新进商品合并新发一条，其他变化更新最近消息，无变化不操作。
# 同一商品当天只触发一次新消息，已通知商品再次出现仅标返榜。
# 去重日从 07:00 起算；NOTIFY_INTERVAL_HOURS、MONITOR_DOMINANCE_POLLS 不再使用。
# 北京时间 [01:00, 07:00) 继续采集，不发送或编辑；相同值表示关闭静默。
QUIET_START_HOUR=1
QUIET_END_HOUR=7

# 可选：需要登录态时填写浏览器 Cookie。包含 $ 时使用单引号包围整段值。
SMZDM_COOKIE=
# 填 Vantage 线上 Worker 的 PostgreSQL 连接串，程序只读 proxy_nodes 表取得代理。
# 示例：VANTAGE_CONNECTION_STRING='Host=db-host;Port=5432;Database=vantage;Username=reader;Password=your-password'
# 每轮刷新健康且未被 Vantage 租用的节点，优先沿用成功节点；连接失败才换，单轮最多 3 个。
# 不修改 Vantage 健康状态或租约；不会自动建表。无可用节点或 DB 故障时不回退直连。
# 网页与商品图片走代理，Telegram 沿用原网络设置；数据库连接串不要填到 MONITOR_PROXY_URL。
VANTAGE_CONNECTION_STRING=''
# 可选替代：不使用数据库池时可填单个 HTTP/HTTPS 代理 URL，两项只能填一个。
# MONITOR_PROXY_URL='http://username:password@proxy-host:8080'
MONITOR_PROXY_URL=''
# 可选：容器可访问的代理地址；127.0.0.1 指的是容器自己。
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1
