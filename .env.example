# BotFather 创建机器人后取得 token；不要提交真实凭据。
TELEGRAM_BOT_TOKEN=
# 私聊的数字 ID、群组的负数 ID，或频道 @username
TELEGRAM_CHAT_ID=
# 可选：论坛群组话题 ID；普通会话留空
TELEGRAM_MESSAGE_THREAD_ID=
# 榜单使用原生富消息（Bot API 10.3+）；Telegram 客户端需支持富消息和标题复制按钮。

# 默认按北京时间整点、半点采集；中途启动仅静默建立基线。
MONITOR_INTERVAL_MINUTES=30
MONITOR_TOP_COUNT=20
MONITOR_DOMINANCE_POLLS=3

# 服务启动/重启时发送一条独立状态消息；仍遵守静默时段，false 可关闭。
NOTIFY_ON_STARTUP=true

# 默认整点新发、半点更新；可改为每 2/3 小时整点新发，其间编辑原消息。
# 中途启动且本时段没有已发榜单时，等下个新消息时间点再发，不在更新点补发。
NOTIFY_INTERVAL_HOURS=1
# 北京时间 [01:00, 07:00) 继续采集，不发送或编辑；相同值表示关闭静默。
QUIET_START_HOUR=1
QUIET_END_HOUR=7

# 可选：需要登录态时填写浏览器 Cookie。包含 $ 时使用单引号包围整段值。
SMZDM_COOKIE=
# 可选：容器可访问的代理地址；127.0.0.1 指的是容器自己。
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1
